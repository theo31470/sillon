# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par git).

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique « publishable » (sb_publishable_…) ou ancienne clé « anon »
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_… ou service_role) : serveur uniquement, contourne la sécurité RLS
SUPABASE_SECRET_KEY=

# --- Stripe (Developers → API keys / Webhooks) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Identifiant du prix mensuel de la formule Complet (price_...)
STRIPE_PRICE_COMPLET=price_...
# Prix affiché sur le site (doit correspondre au prix Stripe)
NEXT_PUBLIC_PRICE_COMPLET_LABEL=19 €

# --- Claude / Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé pour les fiches et le diagnostic (facultatif)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Import des tracteurs par marque : modèle Claude utilisé (Haiku, bien moins cher que Sonnet)
ANTHROPIC_IMPORT_MODEL=claude-haiku-5-5
# Budget IA par jour en dollars : au-delà, la file d'import se met en pause.
CATALOG_DAILY_BUDGET_USD=1
