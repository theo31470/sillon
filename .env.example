# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez JAMAIS .env.local (il est ignoré par git).

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique « publishable » (sb_publishable_…) ou ancienne clé « anon »
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_… ou service_role) : serveur uniquement, contourne la sécurité RLS
SUPABASE_SECRET_KEY=

# --- Stripe (Developers → API keys / Webhooks) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Identifiants des prix de la formule Complet (price_...) : 6,99 €/mois et 69 €/an
STRIPE_PRICE_COMPLET=price_...
STRIPE_PRICE_COMPLET_ANNUEL=price_...

# --- Claude / Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé pour les fiches et le diagnostic (facultatif)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Import des tracteurs par marque : modèle Claude utilisé (Haiku, bien moins cher que Sonnet)
ANTHROPIC_IMPORT_MODEL=claude-haiku-5-5
# Budget IA par jour en dollars : au-delà, la file d'import se met en pause.
CATALOG_DAILY_BUDGET_USD=1

# --- E-mails (resend.com → API Keys) ---
# Clé d'envoi Resend : serveur uniquement
RESEND_API_KEY=re_...
# Expéditeur : une adresse de VOTRE domaine, vérifié dans Resend
EMAIL_FROM=Tracteurs & Co <bonjour@votre-domaine.fr>
# Adresse de réponse (facultatif)
EMAIL_REPLY_TO=
# Secret du hook « Send Email » (Supabase → Authentication → Hooks), format v1,whsec_...
SEND_EMAIL_HOOK_SECRET=
